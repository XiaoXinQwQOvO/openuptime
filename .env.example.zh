# OpenUptime 环境变量（Debian 直接用 Node 运行，不使用 Docker）
# 复制为 .env 后修改：cp env.example .env

# ---------- 必填 ----------
# MySQL 8 连接串。数据库和账号需要提前创建，账号要有建表权限。
DATABASE_URL=mysql://openuptime:换成强密码@127.0.0.1:3306/openuptime

# 会话与加密密钥，至少 32 个随机字符，用 `openssl rand -hex 32` 生成。
BETTER_AUTH_SECRET=换成随机字符串

# 对外访问地址，必须带协议。登录回调、状态页和邮件链接都以它为准。
BETTER_AUTH_URL=https://uptime.example.com
WEB_ORIGIN=https://uptime.example.com

# 监听端口，Nginx 反向代理到这里。
PORT=8080

# 前端构建产物目录，相对于启动目录；压缩包解压后就是 web。
WEB_DIST=web

# ---------- 常用 ----------
# 外部调度器调用 POST /internal/run-checks 时使用（请求头 x-cron-secret）；不设置则 /internal/* 关闭。
# CRON_SECRET=换成随机字符串

# 应用在 Nginx / Caddy 等一层反向代理后面时设为 true，登录和注册限流会按真实客户端 IP 计数。
# TRUST_PROXY=true

# 自己的账号创建好后关闭公开注册；已有邀请的人仍可加入。
# DISABLE_SIGNUP=true

# 邀请链接有效期，单位天，默认 7。
# INVITE_TTL_DAYS=7

# 允许监控私网、回环和单标签地址。默认关闭，避免注册用户探测你的内网。
# ALLOW_PRIVATE_TARGETS=true

# MySQL 连接池上限，默认 10。
# DB_POOL_MAX=10

# 状态页底部 “Powered by” 链接地址，默认 https://openuptime.app。
# PRODUCT_URL=https://openuptime.app

# HTTP 检查和 Webhook 告警使用的代理（HTTP CONNECT 隧道）。
# OUTBOUND_PROXY=http://user:pass@proxy.internal:3128

# HTTP 检查发送的 User-Agent，默认 OpenUptime/0.1。
# CHECK_USER_AGENT=

# 自检 URL，逗号分隔。用于区分“目标挂了”还是“本机断网”。
# 不设置时使用三个公开地址；设为空（SELFCHECK_URLS=）可关闭自检。
# SELFCHECK_URLS=

# ---------- 邮件（邀请、找回密码、邮件告警、状态页订阅） ----------
# 发件地址。
# EMAIL_FROM=alerts@example.com

# 使用 Resend 时只填 API Key，EMAIL_FROM 的域名需先在 Resend 验证。
# RESEND_API_KEY=re_xxx

# 或者使用 SMTP：
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# 也可以分开写：
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=true

# ---------- 第三方登录 / 人机验证 ----------
# GitHub OAuth App 的回调地址填：${BETTER_AUTH_URL}/api/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Cloudflare Turnstile 注册页人机验证，两个都填才启用。
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# 注册页显示“同意服务条款 / 隐私政策”。启用前请先替换 /terms 和 /privacy 的内容。
# LEGAL_LINKS=true

# ---------- 多区域探测（可选） ----------
# PROBE_SECRET=
# PROBE_REGIONS={"us-east":"https://probe.example.app/api/probe/us-east","eu-central":"https://probe.example.app/api/probe/eu-central"}

# ---------- iOS 推送（可选，四项都要填） ----------
# APNS_KEY 中的换行写成 \n。
# APNS_KEY=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=

# ---------- 访问统计（可选） ----------
# PLAUSIBLE_DOMAIN=status.example.com
# PLAUSIBLE_SRC=https://stats.example.com/js/script.js